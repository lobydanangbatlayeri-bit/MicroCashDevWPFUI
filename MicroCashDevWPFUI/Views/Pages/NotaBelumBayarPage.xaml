<Page x:Class="MicroCashDevWPFUI.Views.Pages.NotaBelumBayarPage"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	  xmlns:local="clr-namespace:MicroCashDevWPFUI.Views.Pages"
	  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
	  xmlns:helpers="clr-namespace:MicroCashDevWPFUI.Helpers"
	  xmlns:conv="clr-namespace:MicroCashDevWPFUI.Converters"
	  d:DataContext="{d:DesignInstance local:NotaBelumBayarPage,
                      IsDesignTimeCreatable=False}"
	  mc:Ignorable="d"
	  d:DesignHeight="450"
	  d:DesignWidth="800"
	  Title="NotaBelumBayarPage"
	  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
	  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
	  Foreground="{DynamicResource TextFillColorPrimaryBrush}">

	<StackPanel Orientation="Vertical">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="50" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>
			<Grid Grid.Row="0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="auto" />
					<ColumnDefinition Width="auto" />
				</Grid.ColumnDefinitions>
				<Grid Grid.Column="0">
					<StackPanel Orientation="Horizontal">
						<ui:TextBlock Padding="0,16"
									  VerticalAlignment="Center"
									  HorizontalAlignment="Left"
									  Text="Cari Barang" />
						<ui:AutoSuggestBox Width="200"
										   Margin="10,0,0,0"
										   PlaceholderText="Masukkan Nomor Faktur"
										   Text="{Binding ViewModel.NomorFaktur, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
										   OriginalItemsSource="{Binding ViewModel.NomorFakturList, Mode=OneWay}" />
					</StackPanel>
				</Grid>
				<!--<Grid Grid.Column="1">
					<StackPanel Orientation="Horizontal"
								HorizontalAlignment="Center">
						<Button Command="{Binding ViewModel.TanggalBackCommand, Mode=OneWay}"
								VerticalAlignment="Center"
								Margin="0,0,10,0">
							<ui:SymbolIcon Symbol="ArrowLeft20"
										   FontSize="24" />
						</Button>
						<ui:TextBlock Padding="0,16"
									  VerticalAlignment="Center"
									  HorizontalAlignment="Center"
									  FontSize="20"
									  FontWeight="Bold"
									  Text="{Binding ViewModel.TanggalText, Mode=OneWay}" />
						<Button Command="{Binding ViewModel.TanggalNextCommand, Mode=OneWay}"
								VerticalAlignment="Center"
								Margin="10,0,0,0">
							<ui:SymbolIcon Symbol="ArrowRight20"
										   FontSize="24" />
						</Button>

					</StackPanel>
				</Grid>-->
				<Grid Grid.Column="2">
					<StackPanel Orientation="Horizontal">
						<ui:TextBlock Padding="0,16"
									  VerticalAlignment="Center"
									  HorizontalAlignment="Right"
									  Text="Total Pembelian: " />
						<ui:TextBlock Padding="0,16"
									  VerticalAlignment="Center"
									  HorizontalAlignment="Right"
									  FontWeight="Bold"
									  Text="{Binding ViewModel.TotalNotaText, Mode=OneWay}" />
					</StackPanel>
				</Grid>
				<Grid Grid.Column="3">
					<StackPanel Orientation="Horizontal">
						<Button Command="{Binding ViewModel.ExportCommand, Mode=OneWay}"
								VerticalAlignment="Center"
								HorizontalAlignment="Right"
								ToolTip="Export Ke Excel">
							<ui:SymbolIcon Symbol="DocumentMultiple20"
										   FontSize="24" />
						</Button>
					</StackPanel>
				</Grid>
			</Grid>
			<Grid Grid.Row="1"
				  Margin="0,8"
				  Width="Auto">
				<Grid.RowDefinitions>
					<RowDefinition Height="*" />
					<RowDefinition Height="auto" />
				</Grid.RowDefinitions>
				<ui:DataGrid x:Name="dgNota"
							 ItemsSource="{Binding ViewModel.ItemsNota}"
							 AutoGenerateColumns="False"
							 CanUserAddRows="False"
							 CanUserDeleteRows="False"
							 HeadersVisibility="Column"
							 SelectionMode="Single"
							 SelectionUnit="FullRow"
							 MaxHeight="600"
							 helpers:DataGridAutoSaveBehavior.IsEnabled="True"
							 Grid.Row="0">
					<ui:DataGrid.Columns>
						<DataGridTextColumn Header="No."
											Binding="{Binding Nomor, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
											Width="auto"
											IsReadOnly="True" />
						<DataGridTextColumn Header="Nomor Faktur"
											Width="*"
											Binding="{Binding NomorFaktur, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
						<DataGridTextColumn Header="Tanggal Deadline"
											Width="*"
											Binding="{Binding TanggalDeadline,
											StringFormat='{}{0:dd/MM/yyyy}',
											ConverterCulture=id-ID,
											UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
						<DataGridTemplateColumn Header="Supplier"
												Width="*"
												IsReadOnly="True">

							<!-- Mode tampil (read-only) -->
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding Supplier.NamaSupplier}" />
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>

							<!-- Mode edit -->
							<DataGridTemplateColumn.CellEditingTemplate>
								<DataTemplate>
									<ComboBox ItemsSource="{Binding DataContext.ViewModel.ItemsSupplier,
										  RelativeSource={RelativeSource AncestorType=Page}}"
											  SelectedItem="{Binding Supplier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
											  DisplayMemberPath="NamaSupplier" />
								</DataTemplate>
							</DataGridTemplateColumn.CellEditingTemplate>

						</DataGridTemplateColumn>

						<DataGridTextColumn Header="Item"
											Width="*"
											Binding="{Binding Item}"
											IsReadOnly="True" />
						<DataGridTextColumn Header="Total"
											Width="*"
											Binding="{Binding Total, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
						<DataGridCheckBoxColumn Header="Status Pembayaran"
												Width="*"
												Binding="{Binding StatusPembayaran, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
					</ui:DataGrid.Columns>

					<ui:DataGrid.RowDetailsTemplate>
						<DataTemplate>
							<Border Padding="8"
									Margin="4"
									Background="#0F000000"
									CornerRadius="6">

								<StackPanel>

									<!-- BANK -->
									<TextBlock Text="BANK"
											   FontWeight="SemiBold"
											   Margin="0,0,0,6" />

									<ui:DataGrid ItemsSource="{Binding Bank}"
												 AutoGenerateColumns="False"
												 CanUserAddRows="False"
												 HeadersVisibility="Column"
												 MaxHeight="250"
												 helpers:DataGridAutoSaveBehavior.IsEnabled="True">

										<ui:DataGrid.Columns>
											<DataGridTextColumn Header="Nama Bank"
																Binding="{Binding NamaBank}"
																IsReadOnly="True" />
											<DataGridTextColumn Header="Nomor Rekening"
																Binding="{Binding NomorRekening}"
																IsReadOnly="True" />
										</ui:DataGrid.Columns>
									</ui:DataGrid>
								</StackPanel>
							</Border>
						</DataTemplate>
					</ui:DataGrid.RowDetailsTemplate>
				</ui:DataGrid>
				<StackPanel Orientation="Horizontal"
							HorizontalAlignment="Center"
							Margin="0,8"
							Grid.Row="1">

					<Button Command="{Binding ViewModel.PrevPageCommand}"
							Content="◀"
							Margin="4" />

					<TextBlock Text="{Binding ViewModel.PageInfo}"
							   VerticalAlignment="Center"
							   Margin="8,0" />

					<Button Command="{Binding ViewModel.NextPageCommand}"
							Content="▶"
							Margin="4" />
				</StackPanel>
			</Grid>
		</Grid>
	</StackPanel>
</Page>
