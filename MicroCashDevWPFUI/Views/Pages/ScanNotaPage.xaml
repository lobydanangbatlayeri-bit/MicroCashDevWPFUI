<Page x:Class="MicroCashDevWPFUI.Views.Pages.ScanNotaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MicroCashDevWPFUI.Views.Pages"
	  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
	  xmlns:helpers="clr-namespace:MicroCashDevWPFUI.Helpers"
	  xmlns:conv="clr-namespace:MicroCashDevWPFUI.Converters"
	  d:DataContext="{d:DesignInstance local:ScanNotaPage,
                IsDesignTimeCreatable=False}"
	  mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ScanNotaPage"
	  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
	  ui:Design.Foreground="{DynamicResource TextFillColorPriBrush}"
	  Foreground="{DynamicResource TextFillColorPryBrush}">

	<Grid Margin="24">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<!-- Title -->
			<RowDefinition Height="16" />
			<RowDefinition Height="Auto" />
			<!-- InfoBar -->
			<RowDefinition Height="20" />
			<RowDefinition Height="Auto" />
			<!-- Card Panduan -->
			<RowDefinition Height="20" />
			<RowDefinition Height="*" />
			<!-- QR -->
		</Grid.RowDefinitions>

		<!-- Title -->
		<StackPanel>
			<TextBlock Text="Scan Nota dari HP"
					   FontSize="28"
					   FontWeight="SemiBold" />
			<TextBlock Text="Gunakan HP untuk scan nota melalui browser"
					   Opacity="0.7"
					   Margin="0,4,0,0" />
		</StackPanel>

		<ui:InfoBar Grid.Row="2"
					Severity="{Binding ViewModel.ServerSeverity}"
					Title="{Binding ViewModel.ServerTitle}"
					Message="{Binding ViewModel.ServerStatus}"
					IsOpen="True" />

		<!-- Card Panduan -->
		<ui:Card Grid.Row="4"
				 Padding="20">
			<StackPanel>

				<TextBlock Text="Langkah Menghubungkan:"
						   FontWeight="SemiBold"
						   Margin="0,0,0,12" />

				<TextBlock Text="1. Pastikan HP dan Laptop berada di jaringan WiFi yang sama" />
				<TextBlock Text="2. Buka browser di HP (Chrome / Safari)" />
				<TextBlock Text="3. Ketik alamat berikut:"
						   Margin="0,0,0,12" />

				<!-- URL Box -->
				<Border CornerRadius="8"
						Padding="12"
						Margin="0,0,0,12">
					<TextBlock Text="{Binding ViewModel.ServerUrl}"
							   FontSize="18"
							   FontWeight="SemiBold" />
				</Border>

				<!-- Buttons -->
				<StackPanel Orientation="Horizontal">
					<ui:Button Content="Copy URL"
							   Command="{Binding ViewModel.CopyUrlCommand}"
							   Icon="Copy20" />

					<ui:Button Content="Refresh IP"
							   Command="{Binding ViewModel.RefreshIpCommand}"
							   Icon="ArrowClockwise20" />
				</StackPanel>

			</StackPanel>
		</ui:Card>

		<!-- QR Code Section -->
		<ui:Card Grid.Row="6"
				 Padding="20">
			<StackPanel HorizontalAlignment="Center">

				<TextBlock Text="Atau Scan QR Code"
						   FontWeight="SemiBold"
						   Margin="0,0,0,12" />

				<Image Width="200"
					   Height="200"
					   Source="{Binding ViewModel.QrCodeImage}" />

				<TextBlock Text="{Binding ViewModel.ServerStatus}"
						   Margin="0,12,0,0"
						   HorizontalAlignment="Center"
						   Opacity="0.7" />

			</StackPanel>
		</ui:Card>
	</Grid>

</Page>
