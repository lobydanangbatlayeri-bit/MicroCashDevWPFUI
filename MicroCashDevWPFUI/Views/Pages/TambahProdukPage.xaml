<Page x:Class="MicroCashDevWPFUI.Views.Pages.TambahProdukPage"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	  xmlns:local="clr-namespace:MicroCashDevWPFUI.Views.Pages"
	  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
	  xmlns:helpers="clr-namespace:MicroCashDevWPFUI.Helpers"
	  xmlns:conv="clr-namespace:MicroCashDevWPFUI.Converters"
	  d:DataContext="{d:DesignInstance local:TambahProdukPage,
                                 IsDesignTimeCreatable=False}"
	  mc:Ignorable="d"
	  d:DesignHeight="450"
	  d:DesignWidth="800"
	  Title="TambahProdukPage"
	  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
	  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
	  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
	  Loaded="Page_Loaded">

	<Page.Resources>
		<!-- Expose ViewModel.ItemsSatuan untuk dipakai oleh DataGrid columns -->
		<helpers:BindingProxy x:Key="SatuanProxy"
							  Data="{Binding ViewModel.ItemsSatuan}" />

		<!-- Converter untuk menampilkan format ribuan -->
		<conv:DecimalToFormattedStringConverter x:Key="DecimalFormat" />
	</Page.Resources>

	<StackPanel Orientation="Vertical">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="150" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="auto" />
			</Grid.ColumnDefinitions>

			<ui:TextBlock Padding="0,16"
						  VerticalAlignment="Center"
						  Text="Nama Barang"
						  Grid.Column="0" />

			<ui:AutoSuggestBox x:Name="txtNamaBarang"
							   Grid.Column="1"
							   Text="{Binding ViewModel.NamaBarang, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
							   OriginalItemsSource="{Binding ViewModel.NamaBarangList, Mode=OneWay}"/>

			<ui:Button Height="40"
					   Width="200"
					   Margin="5"
					   Grid.Column="2"
					   Appearance="Primary"
					   Command="{Binding ViewModel.BukaTambahSatuanCommand}">
				<ui:TextBlock Text="Tambah Satuan" />
			</ui:Button>

		</Grid>

		<ui:DataGrid x:Name="dgSatuanProduk"
					 AutoGenerateColumns="False"
					 CanUserAddRows="False"
					 HeadersVisibility="All"
					 IsReadOnly="False"
					 SelectionUnit="Cell"
					 ItemsSource="{Binding ViewModel.ItemsSatuanProduk}"
					 Margin="10">


			<ui:DataGrid.Columns>
				<!-- Ganti DataGridComboBoxColumn dengan DataGridTemplateColumn untuk kontrol penuh -->
				<DataGridTemplateColumn Width="*"
										Header="Satuan">
					<DataGridTemplateColumn.CellTemplate>
						<!-- tampilan saat tidak sedang diedit -->
						<DataTemplate>
							<TextBlock Text="{Binding Satuan.NamaSatuan}"
									   VerticalAlignment="Center"
									   HorizontalAlignment="Left" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>

					<DataGridTemplateColumn.CellEditingTemplate>
						<!-- editing template: ComboBox yang benar-benar berada di visual tree -->
						<DataTemplate>
							<ComboBox ItemsSource="{Binding Data, Source={StaticResource SatuanProxy}}"
									  DisplayMemberPath="NamaSatuan"
									  SelectedItem="{Binding Satuan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
									  IsEnabled="{Binding DataContext.ViewModel.IsEditMode,
												  RelativeSource={RelativeSource AncestorType=Page},
												  Converter={StaticResource InverseBoolConverter}}"
									  IsSynchronizedWithCurrentItem="False"
									  VerticalAlignment="Center"
									  HorizontalAlignment="Stretch" />
						</DataTemplate>
					</DataGridTemplateColumn.CellEditingTemplate>
				</DataGridTemplateColumn>

				<DataGridTemplateColumn Width="*"
										Header="Isi Per Box">

					<!-- Tampilan saat tidak edit -->
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding IsiPerBox}"
									   HorizontalAlignment="Center"
									   VerticalAlignment="Center" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>

					<!-- Tampilan saat edit -->
					<DataGridTemplateColumn.CellEditingTemplate>
						<DataTemplate>
							<TextBox Text="{Binding IsiPerBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
									 HorizontalContentAlignment="Center"
									 VerticalContentAlignment="Center"
									 IsEnabled="{Binding DataContext.ViewModel.IsEditMode,
                                         RelativeSource={RelativeSource AncestorType=Page},
                                         Converter={StaticResource InverseBoolConverter}}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellEditingTemplate>

				</DataGridTemplateColumn>

				<DataGridTextColumn Width="*"
									Binding="{Binding HargaJual}"
									Header="Harga Jual">
					<DataGridTextColumn.ElementStyle>
						<Style TargetType="{x:Type TextBlock}">
							<Setter Property="HorizontalAlignment"
									Value="Center" />
						</Style>
					</DataGridTextColumn.ElementStyle>
				</DataGridTextColumn>

				<DataGridTemplateColumn Header="Options"
										Width="auto">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<Button Command="{Binding DataContext.ViewModel.DeleteProdukSatuanCommand, RelativeSource={RelativeSource AncestorType=Page}}"
									CommandParameter="{Binding}"
									ToolTip="Satuan dasar tidak bisa dihapus">
								<ui:SymbolIcon Symbol="Delete24" />
							</Button>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

			</ui:DataGrid.Columns>

		</ui:DataGrid>

		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<ui:TextBlock Padding="0,16"
						  VerticalAlignment="Center"
						  Text="Pilih Satuan"
						  Grid.Column="1" />
			<ComboBox x:Name="cmbPilihSatuan"
					  Grid.Column="2"
					  ItemsSource="{Binding ViewModel.ItemsSatuan}"
					  DisplayMemberPath="NamaSatuan"
					  Background="LightBlue"
					  SelectedItem="{Binding ViewModel.SelectedSatuan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
		</Grid>

		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<ui:TextBlock Padding="0,16"
						  VerticalAlignment="Center"
						  Text="Isi Per Box"
						  Grid.Column="1" />
			<ui:ToggleSwitch Grid.Column="2"
							 Height="auto"
							 Width="auto"
							 HorizontalAlignment="Center"
							 IsChecked="{Binding ViewModel.IsiPerBoxEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

			<ui:Button Grid.Column="3"
					   Width="auto"
					   Height="auto"
					   HorizontalAlignment="Left"
					   ToolTipService.ShowDuration="60000">

				<ui:Button.Content>
					<ui:SymbolIcon Symbol="Info24" />
				</ui:Button.Content>

				<ui:Button.ToolTip>
					<Border Width="Auto"
							Height="Auto"
							Padding="10">
						<TextBlock TextWrapping="Wrap">
Aktifkan toggle "Isi Per Box" jika ingin mengonversi jumlah produk.

• Box = 100
• Strip = 10
• Butir = 1

Jika toggle dimatikan, default 1.

Contact: 082116765879.
						</TextBlock>
					</Border>
				</ui:Button.ToolTip>

			</ui:Button>

		</Grid>

		<Grid Grid.ColumnSpan="4"
			  Visibility="{Binding ViewModel.IsiPerBoxEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="150" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<ui:TextBlock Padding="0,16"
						  VerticalAlignment="Center"
						  Text="Berapa Isi Per Box?"
						  Grid.Column="0" />

			<ui:NumberBox Grid.Column="1"
						  Value="{Binding ViewModel.IsiPerBoxInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
		</Grid>

		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="150" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<ui:TextBlock Padding="0,16"
						  VerticalAlignment="Center"
						  Text="Harga Jual"
						  Grid.Column="0" />

			<TextBox Grid.Column="1"
					 Text="{Binding ViewModel.HargaJualInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DecimalFormat}}"
					 helpers:ThousandSeparatorBehavior.IsEnabled="True"
					 VerticalAlignment="Center"
					 HorizontalAlignment="Stretch" />
		</Grid>

		<Grid>
			<ui:Button Height="40"
					   Width="200"
					   Margin="5"
					   Grid.Column="1"
					   HorizontalAlignment="Center"
					   Appearance="Success"
					   Command="{Binding ViewModel.TambahSatuanProdukCommand}"
					   Click="BtnTambah_Click">
				<ui:TextBlock Text="Tambah" />
			</ui:Button>
		</Grid>

		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<ui:Button Height="60"
					   Width="150"
					   Margin="20"
					   Grid.Column="1"
					   Appearance="Primary"
					   Command="{Binding ViewModel.SimpanProdukCommand}"
					   Click="BtnSave_Click">
				<ui:TextBlock Text="Save" />
			</ui:Button>

			<ui:Button Height="60"
					   Width="150"
					   Margin="20"
					   Grid.Column="2"
					   Appearance="Dark"
					   Command="{Binding ViewModel.CancelCommand}"
					   Click="BtnCancel_Click">
				<ui:TextBlock Text="Cancel" />
			</ui:Button>
		</Grid>

	</StackPanel>
</Page>
