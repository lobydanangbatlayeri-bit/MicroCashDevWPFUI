<Page x:Class="MicroCashDevWPFUI.Views.Pages.ProdukPage"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	  xmlns:local="clr-namespace:MicroCashDevWPFUI.Views.Pages"
	  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
	  d:DataContext="{d:DesignInstance local:ProdukPage,
                IsDesignTimeCreatable=False}"
	  mc:Ignorable="d"
	  d:DesignHeight="450"
	  d:DesignWidth="800"
	  Title="ProdukPage"
	  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
	  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
	  Foreground="{DynamicResource TextFillColorPrimaryBrush}">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<StackPanel Orientation="Horizontal" Grid.Row="0">
			<ui:TextBlock Padding="0,16"
						  VerticalAlignment="Center"
						  HorizontalAlignment="Left"
						  Text="Cari Barang" />
			<ui:AutoSuggestBox Width="200"
							   Margin="10,0,0,0"
							   PlaceholderText="Masukkan Nama Barang"
							   Text="{Binding ViewModel.NamaBarang, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
							   OriginalItemsSource="{Binding ViewModel.NamaBarangList, Mode=OneWay}" />
		</StackPanel>

		<ui:DataGrid x:Name="dgProduk"
					 AutoGenerateColumns="False"
					 CanUserAddRows="False"
					 IsReadOnly="False"
					 ItemsSource="{Binding ViewModel.ItemsProduk}"
					 Grid.Row="1">
			<ui:DataGrid.Columns>

				<DataGridTextColumn Header="Nama Barang"
									Binding="{Binding NamaBarang, Mode=TwoWay}"
									Width="*" />

				<DataGridTemplateColumn Header="Satuan"
										Width="150">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding Satuan}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>

					<DataGridTemplateColumn.CellEditingTemplate>
						<DataTemplate>
							<!-- ItemsSource sekarang mengikat ke SatuanList pada row (ProdukItem.SatuanList) -->
							<ComboBox ItemsSource="{Binding SatuanList}"
									  SelectedItem="{Binding Satuan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellEditingTemplate>
				</DataGridTemplateColumn>

				<DataGridTextColumn Header="Varian"
									Binding="{Binding Varian, Mode=OneWay}"
									Width="150"
									IsReadOnly="True" />

				<DataGridTextColumn Header="Total Stok"
									Binding="{Binding CurrentStok}"
									IsReadOnly="True"
									Width="120" />

				<DataGridTextColumn Header="Harga Jual"
									Binding="{Binding HargaJual, Mode=TwoWay, StringFormat=N0}"
									Width="150" />

				<DataGridTemplateColumn Header="Options"
										Width="auto">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<Button Command="{Binding DataContext.ViewModel.DeleteProdukCommand, RelativeSource={RelativeSource AncestorType=Page}}"
									CommandParameter="{Binding}">
								<ui:SymbolIcon Symbol="Delete24" />
							</Button>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

			</ui:DataGrid.Columns>
		</ui:DataGrid>
		<!-- Pagination controls -->
		<StackPanel Orientation="Horizontal"
					HorizontalAlignment="Center"
					Margin="0,8"
					Grid.Row="2">

			<Button Command="{Binding ViewModel.PrevPageCommand}"
					Content="◀"
					Margin="4" />

			<TextBlock Text="{Binding ViewModel.PageInfo}"
					   VerticalAlignment="Center"
					   Margin="8,0" />

			<Button Command="{Binding ViewModel.NextPageCommand}"
					Content="▶"
					Margin="4" />
		</StackPanel>
		<StackPanel Orientation="Horizontal"
					Grid.Row="3"
					HorizontalAlignment="Center">
			<ui:Button Height="60"
					   Width="150"
					   Margin="20"
					   Grid.Column="1"
					   Appearance="Primary"
					   Command="{Binding ViewModel.SimpanCommand}">
				<ui:TextBlock Text="Save" />
			</ui:Button>

			<ui:Button Height="60"
					   Width="150"
					   Margin="20"
					   Grid.Column="2"
					   Appearance="Dark"
					   Command="{Binding ViewModel.CancelCommand}">
				<ui:TextBlock Text="Cancel" />
			</ui:Button>
		</StackPanel>

	</Grid>
		
		
</Page>
