<Page x:Class="MicroCashDevWPFUI.Views.Pages.RestokManualPage"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	  xmlns:local="clr-namespace:MicroCashDevWPFUI.Views.Pages"
	  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
	  xmlns:helpers="clr-namespace:MicroCashDevWPFUI.Helpers"
	  d:DataContext="{d:DesignInstance local:RestokManualPage,
                           IsDesignTimeCreatable=False}"
	  mc:Ignorable="d"
	  d:DesignHeight="450"
	  d:DesignWidth="800"
	  Title="RestokManualPage"
	  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
	  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
	  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
	  Loaded="Page_Loaded">

	<StackPanel Orientation="Vertical">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="150" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<ui:TextBlock Padding="0,16"
						  VerticalAlignment="Center"
						  Text="Nama Barang"
						  Grid.Column="0" />

			<ui:AutoSuggestBox x:Name="txtNamaBarang"
							   Grid.Column="1"
							   Text="{Binding ViewModel.NamaBarang, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
							   OriginalItemsSource="{Binding ViewModel.NamaBarangList, Mode=OneWay}"/>
		</Grid>

		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="150" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<ui:TextBlock Padding="0,16"
						  VerticalAlignment="Center"
						  Text="Tanggal Kadarluasa"
						  Grid.Column="0" />

			<DatePicker Grid.Column="1"
						SelectedDate="{Binding ViewModel.TanggalKadarluasa, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
						SelectedDateFormat="Short"
						Language="id-ID" />
		</Grid>

		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="150" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="auto" />
			</Grid.ColumnDefinitions>

			<ui:TextBlock Padding="0,16"
						  VerticalAlignment="Center"
						  Text="Sisa Stock"
						  Grid.Column="0" />

			<ui:NumberBox Grid.Column="1"
						  Value="{Binding ViewModel.SisaStok}"
						  IsReadOnly="True" />

			<ComboBox Grid.Column="2"
					  Margin="8,0,0,0"
					  Width="100"
					  ItemsSource="{Binding ViewModel.ItemsSatuan}"
					  SelectedItem="{Binding ViewModel.SelectedSatuan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
					  DisplayMemberPath="Satuan.NamaSatuan" />
		</Grid>

		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="150" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<ui:TextBlock Padding="0,16"
						  VerticalAlignment="Center"
						  Text="Tambahkan Stock"
						  Grid.Column="0" />

			<ui:NumberBox Grid.Column="1"
						  Value="{Binding ViewModel.TambahStock, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
		</Grid>

		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="150" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<ui:TextBlock Padding="0,16"
						  VerticalAlignment="Center"
						  Text="Estimasi Harga Beli"
						  Grid.Column="0" />

			<!-- Ganti NumberBox dengan TextBox terformat (editable) -->
			<TextBox Grid.Column="1"
					 Text="{Binding ViewModel.EstimasiHargaBeli, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DecimalFormat}}"
					 helpers:ThousandSeparatorBehavior.IsEnabled="True"
					 VerticalAlignment="Center"
					 HorizontalAlignment="Stretch" />
		</Grid>

		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<ui:Button Height="60"
					   Width="150"
					   Margin="20"
					   Grid.Column="1"
					   Appearance="Primary"
					   Command="{Binding ViewModel.SimpanCommand}"
					   Click="BtnSave_Click">
				<ui:TextBlock Text="Save" />
			</ui:Button>

			<ui:Button Height="60"
					   Width="150"
					   Margin="20"
					   Grid.Column="2"
					   Appearance="Dark"
					   Command="{Binding ViewModel.CancelCommand}"
					   Click="BtnCancel_Click">
				<ui:TextBlock Text="Cancel" />
			</ui:Button>
		</Grid>

	</StackPanel>
</Page>
