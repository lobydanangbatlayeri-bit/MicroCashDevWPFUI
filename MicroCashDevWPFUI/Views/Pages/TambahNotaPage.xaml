<Page x:Class="MicroCashDevWPFUI.Views.Pages.TambahNotaPage"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	  xmlns:local="clr-namespace:MicroCashDevWPFUI.Views.Pages"
	  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
	  xmlns:helpers="clr-namespace:MicroCashDevWPFUI.Helpers"
	  xmlns:conv="clr-namespace:MicroCashDevWPFUI.Converters"
	  d:DataContext="{d:DesignInstance local:TambahNotaPage,
                           IsDesignTimeCreatable=False}"
	  mc:Ignorable="d"
	  d:DesignHeight="450"
	  d:DesignWidth="800"
	  Title="TambahNotaPage"
	  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
	  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
	  Foreground="{DynamicResource TextFillColorPrimaryBrush}">

	<StackPanel Orientation="Vertical">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<ui:TextBlock Padding="0,16"
						  VerticalAlignment="Center"
						  Text="Pilih Supplier"
						  Grid.Column="1" />
			<ComboBox Grid.Column="2"
					  ItemsSource="{Binding ViewModel.ItemsSupplier}"
					  DisplayMemberPath="NamaSupplier"
					  Background="LightBlue"
					  SelectedItem="{Binding ViewModel.SelectedSupplier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
		</Grid>
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="150" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<ui:TextBlock Padding="0,16"
						  VerticalAlignment="Center"
						  Text="Nomor Faktur"
						  Grid.Column="0" />

			<ui:AutoSuggestBox Grid.Column="1"
							   Text="{Binding ViewModel.NomorFaktur, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
							   OriginalItemsSource="{Binding ViewModel.NomorFakturList, Mode=OneWay}" />
		</Grid>
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="150" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<ui:TextBlock Padding="0,16"
						  VerticalAlignment="Center"
						  Text="Status Pembayaran"
						  Grid.Column="0" />

			<CheckBox Grid.Column="1"
					  IsChecked="{Binding ViewModel.StatusPembayaran, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
		</Grid>
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="150" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<ui:TextBlock Padding="0,16"
						  VerticalAlignment="Center"
						  Text="Tanggal Masuk"
						  Grid.Column="0" />
			<DatePicker Grid.Column="1"
						SelectedDate="{Binding ViewModel.TanggalMasuk, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
						SelectedDateFormat="Short"
						Language="id-ID" />
		</Grid>
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="150" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<ui:TextBlock Padding="0,16"
						  VerticalAlignment="Center"
						  Text="Tanggal Deadline"
						  Grid.Column="0" />
			<DatePicker Grid.Column="1"
						SelectedDate="{Binding ViewModel.TanggalDeadline, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
						SelectedDateFormat="Short"
						Language="id-ID" />
		</Grid>
		<Grid>
			<ui:Button Height="40"
					   Width="200"
					   Margin="5"
					   Grid.Column="1"
					   HorizontalAlignment="Center"
					   Appearance="Success"
					   Command="{Binding ViewModel.BukaTambahBankCommand}">
				<ui:TextBlock Text="Tambah Bank" />
			</ui:Button>
		</Grid>
		<ui:DataGrid x:Name="dgBank"
					 AutoGenerateColumns="False"
					 CanUserAddRows="False"
					 HeadersVisibility="All"
					 IsReadOnly="False"
					 SelectionUnit="Cell"
					 ItemsSource="{Binding ViewModel.ItemsBank}"
					 Margin="10">
			<ui:DataGrid.Columns>
				<DataGridTextColumn Header="Nama Bank"
									Binding="{Binding NamaBank}"
									Width="2*" />
				<DataGridTextColumn Header="Nomor Rekening"
									Binding="{Binding NomorRekening}"
									Width="2*" />
				<DataGridTemplateColumn Header="Options"
										Width="auto">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<Button Command="{Binding DataContext.ViewModel.DeleteBankCommand, RelativeSource={RelativeSource AncestorType=Page}}"
									CommandParameter="{Binding}">
								<ui:SymbolIcon Symbol="Delete24" />
							</Button>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

			</ui:DataGrid.Columns>
		</ui:DataGrid>
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="150" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<ui:TextBlock Padding="0,16"
						  VerticalAlignment="Center"
						  Text="Total"
						  Grid.Column="0" />

			<TextBox Grid.Column="1"
					 Text="{Binding ViewModel.Total, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DecimalFormat}}"
					 VerticalAlignment="Center"
					 HorizontalAlignment="Stretch" />
		</Grid>
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<ui:Button Height="60"
					   Width="150"
					   Margin="20"
					   Grid.Column="1"
					   Appearance="Primary"
					   Command="{Binding ViewModel.SimpanCommand}">
				<ui:TextBlock Text="Save" />
			</ui:Button>

			<ui:Button Height="60"
					   Width="150"
					   Margin="20"
					   Grid.Column="2"
					   Appearance="Dark"
					   Command="{Binding ViewModel.CancelCommand}">
				<ui:TextBlock Text="Cancel" />
			</ui:Button>
		</Grid>
	</StackPanel>
</Page>
