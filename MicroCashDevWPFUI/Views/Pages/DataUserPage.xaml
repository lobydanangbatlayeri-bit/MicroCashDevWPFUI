<Page x:Class="MicroCashDevWPFUI.Views.Pages.DataUserPage"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	  xmlns:local="clr-namespace:MicroCashDevWPFUI.Views.Pages"
	  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
	  xmlns:helpers="clr-namespace:MicroCashDevWPFUI.Helpers"
	  xmlns:conv="clr-namespace:MicroCashDevWPFUI.Converters"
	  d:DataContext="{d:DesignInstance local:DataUserPage,
                            IsDesignTimeCreatable=False}"
	  mc:Ignorable="d"
	  d:DesignHeight="450"
	  d:DesignWidth="800"
	  Title="DataUserPage"
	  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
	  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
	  Foreground="{DynamicResource TextFillColorPrimaryBrush}">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<StackPanel Grid.Row="0"
					Orientation="Vertical">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="150" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<ui:TextBlock Padding="0,16"
							  VerticalAlignment="Center"
							  HorizontalAlignment="Left"
							  Text="Masukkan Username"
							  Grid.Column="0" />
				<ui:TextBox Grid.Column="1"
							Margin="10,0,0,0"
							VerticalContentAlignment="Center"
							Text="{Binding ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
			</Grid>
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="150" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<ui:TextBlock Padding="0,16"
							  VerticalAlignment="Center"
							  HorizontalAlignment="Left"
							  Text="Masukkan Password"
							  Grid.Column="0" />
				<ui:PasswordBox x:Name="PasswordBox"
								Margin="10,0,0,0"
								Icon="Password24"
								helpers:PasswordBoxHelper.BindPassword="True"
								helpers:PasswordBoxHelper.BoundPassword="{Binding ViewModel.Password, Mode=TwoWay}"
								Grid.Column="1" />
			</Grid>
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition />
					<ColumnDefinition />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>
				<ui:Button Height="60"
						   Width="150"
						   Margin="20"
						   Grid.Column="1"
						   Appearance="Primary"
						   Command="{Binding ViewModel.SimpanCommand}">
					<ui:TextBlock Text="Save" />
				</ui:Button>

				<ui:Button Height="60"
						   Width="150"
						   Margin="20"
						   Grid.Column="2"
						   Appearance="Dark"
						   Command="{Binding ViewModel.CancelCommand}">
					<ui:TextBlock Text="Cancel" />
				</ui:Button>
			</Grid>
		</StackPanel>
		<ui:DataGrid Grid.Row="1"
					 x:Name="dgUser"
					 AutoGenerateColumns="False"
					 CanUserAddRows="False"
					 HeadersVisibility="All"
					 IsReadOnly="False"
					 SelectionUnit="Cell"
					 ItemsSource="{Binding ViewModel.ItemsUser}"
					 Margin="10">
			<ui:DataGrid.Columns>
				<DataGridTextColumn Header="Username"
									Binding="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
									Width="*" />
				<DataGridTextColumn Header="Password"
									Binding="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
									Width="*" />
				<DataGridTemplateColumn Header="Options"
										Width="auto">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<Button Command="{Binding DataContext.ViewModel.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=Page}}"
									CommandParameter="{Binding}">
								<ui:SymbolIcon Symbol="Delete24" />
							</Button>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
			</ui:DataGrid.Columns>
		</ui:DataGrid>
	</Grid>
</Page>
