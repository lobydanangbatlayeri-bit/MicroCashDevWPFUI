<Page x:Class="MicroCashDevWPFUI.Views.Pages.ProfileTokoPage"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	  xmlns:local="clr-namespace:MicroCashDevWPFUI.Views.Pages"
	  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
	  xmlns:helpers="clr-namespace:MicroCashDevWPFUI.Helpers"
	  xmlns:conv="clr-namespace:MicroCashDevWPFUI.Converters"
	  d:DataContext="{d:DesignInstance local:ProfileTokoPage,
                      IsDesignTimeCreatable=False}"
	  mc:Ignorable="d"
	  d:DesignHeight="450"
	  d:DesignWidth="800"
	  Title="ProfileTokoPage"
	  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
	  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
	  Foreground="{DynamicResource TextFillColorPrimaryBrush}">

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- HEADER -->
		<StackPanel Grid.Row="0"
					Margin="0,0,0,20">
			<TextBlock Text="Kelola informasi toko yang akan tampil pada nota dan laporan."
					   Opacity="0.7" />
		</StackPanel>

		<!-- CARD -->
		<Border Grid.Row="1"
				CornerRadius="16"
				Padding="30"
				Width="500"
				HorizontalAlignment="Center"
				Background="#F0FBF6"
				BorderBrush="#CDEFE0"
				BorderThickness="1">

			<StackPanel>

				<!-- Nama Toko -->
				<StackPanel Margin="0,0,0,20">
					<TextBlock Text="Nama Toko"
							   FontWeight="SemiBold"
							   Margin="0,0,0,6" />
					<TextBox Height="40"
							 Padding="10"
							 FontSize="14"
							 Text="{Binding ViewModel.NamaToko, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
				</StackPanel>

				<!-- Alamat Toko -->
				<StackPanel Margin="0,0,0,20">
					<TextBlock Text="Alamat Toko"
							   FontWeight="SemiBold"
							   Margin="0,0,0,6" />
					<TextBox Height="80"
							 Padding="10"
							 AcceptsReturn="True"
							 TextWrapping="Wrap"
							 VerticalScrollBarVisibility="Auto"
							 FontSize="14"
							 Text="{Binding ViewModel.AlamatToko, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
				</StackPanel>

				<!-- Kata Sambutan -->
				<StackPanel Margin="0,0,0,25">
					<TextBlock Text="Kata Sambutan"
							   FontWeight="SemiBold"
							   Margin="0,0,0,6" />
					<TextBox Height="100"
							 Padding="10"
							 AcceptsReturn="True"
							 TextWrapping="Wrap"
							 VerticalScrollBarVisibility="Auto"
							 FontSize="14"
							 Text="{Binding ViewModel.KataSambutan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
				</StackPanel>

				<!-- BUTTONS -->
				<StackPanel Orientation="Horizontal"
							HorizontalAlignment="Center">

					<ui:Button Height="60"
							   Width="150"
							   Margin="20"
							   Grid.Column="1"
							   Appearance="Primary"
							   Command="{Binding ViewModel.SimpanCommand}">
						<ui:TextBlock Text="Save" />
					</ui:Button>
				</StackPanel>

			</StackPanel>
		</Border>
	</Grid>
</Page>
