<Page x:Class="MicroCashDevWPFUI.Views.Pages.LabaPertahunPage"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	  xmlns:local="clr-namespace:MicroCashDevWPFUI.Views.Pages"
	  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
	  xmlns:helpers="clr-namespace:MicroCashDevWPFUI.Helpers"
	  d:DataContext="{d:DesignInstance local:LabaPertahunPage,
			IsDesignTimeCreatable=False}"
	  mc:Ignorable="d"
	  d:DesignHeight="450"
	  d:DesignWidth="800"
	  Title="LabaPertahunPage"
	  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
	  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
	  Foreground="{DynamicResource TextFillColorPrimaryBrush}">

	<StackPanel Orientation="Vertical">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>
			<Grid Grid.Row="0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="auto" />
					<ColumnDefinition Width="auto" />
				</Grid.ColumnDefinitions>
				<Grid Grid.Column="0">
					<StackPanel Orientation="Horizontal"
								VerticalAlignment="Top">
						<ui:TextBlock Padding="0,16"
									  VerticalAlignment="Center"
									  HorizontalAlignment="Left"
									  Text="Cari Barang" />
						<ui:AutoSuggestBox Width="200"
										   Margin="10,0,0,0"
										   PlaceholderText="Masukkan Nomor Nota"
										   Text="{Binding ViewModel.NomorNota, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
										   OriginalItemsSource="{Binding ViewModel.NomorNotaList, Mode=OneWay}" />
					</StackPanel>
				</Grid>
				<Grid Grid.Column="1"
					  VerticalAlignment="Top">
					<StackPanel Orientation="Horizontal"
								HorizontalAlignment="Center">
						<Button Command="{Binding ViewModel.TahunBackCommand, Mode=OneWay}"
								VerticalAlignment="Center"
								Margin="0,0,10,0">
							<ui:SymbolIcon Symbol="ArrowLeft20"
										   FontSize="24" />
						</Button>
						<ui:TextBlock Padding="0,16"
									  VerticalAlignment="Center"
									  HorizontalAlignment="Center"
									  FontSize="20"
									  FontWeight="Bold"
									  Text="{Binding ViewModel.TahunText, Mode=OneWay}" />
						<Button Command="{Binding ViewModel.TahunNextCommand, Mode=OneWay}"
								VerticalAlignment="Center"
								Margin="10,0,0,0">
							<ui:SymbolIcon Symbol="ArrowRight20"
										   FontSize="24" />
						</Button>

					</StackPanel>
				</Grid>
				<Grid Grid.Column="2">
					<Grid.RowDefinitions>
						<RowDefinition Height="auto" />
						<RowDefinition Height="auto" />
						<RowDefinition Height="auto" />
					</Grid.RowDefinitions>
					<StackPanel Orientation="Horizontal"
								Grid.Row="0">
						<ui:TextBlock Padding="0,16"
									  VerticalAlignment="Center"
									  HorizontalAlignment="Right"
									  Text="Total Penjualan: " />
						<ui:TextBlock Padding="0,16"
									  VerticalAlignment="Center"
									  HorizontalAlignment="Right"
									  FontWeight="Bold"
									  Text="{Binding ViewModel.TotalPenjualanText, Mode=OneWay}" />
					</StackPanel>
					<StackPanel Orientation="Horizontal"
								Grid.Row="1">
						<ui:TextBlock Padding="0,16"
									  VerticalAlignment="Center"
									  HorizontalAlignment="Right"
									  Text="Total Hpp: " />
						<ui:TextBlock Padding="0,16"
									  VerticalAlignment="Center"
									  HorizontalAlignment="Right"
									  FontWeight="Bold"
									  Text="{Binding ViewModel.TotalBiayaText, Mode=OneWay}" />
					</StackPanel>
					<StackPanel Orientation="Horizontal"
								Grid.Row="2">
						<ui:TextBlock Padding="0,16"
									  VerticalAlignment="Center"
									  HorizontalAlignment="Right"
									  Text="Laba Bersih: " />
						<ui:TextBlock Padding="0,16"
									  VerticalAlignment="Center"
									  HorizontalAlignment="Right"
									  FontWeight="Bold"
									  Text="{Binding ViewModel.LabaBersihText, Mode=OneWay}" />
					</StackPanel>
				</Grid>
				<Grid Grid.Column="3">
					<StackPanel Orientation="Horizontal">
						<Button Command="{Binding ViewModel.ExportCommand, Mode=OneWay}"
								VerticalAlignment="Center"
								HorizontalAlignment="Right"
								ToolTip="Export Ke Excel">
							<ui:SymbolIcon Symbol="DocumentMultiple20"
										   FontSize="24" />
						</Button>
					</StackPanel>
				</Grid>
			</Grid>
			<Grid Grid.Row="1"
				  Margin="0,8"
				  Width="Auto">
				<Grid.RowDefinitions>
					<RowDefinition Height="*" />
					<RowDefinition Height="auto" />
				</Grid.RowDefinitions>
				<ui:DataGrid x:Name="dgLaba"
							 ItemsSource="{Binding ViewModel.ItemsLaba}"
							 AutoGenerateColumns="False"
							 CanUserAddRows="False"
							 CanUserDeleteRows="False"
							 HeadersVisibility="Column"
							 SelectionMode="Single"
							 SelectionUnit="FullRow"
							 IsReadOnly="True"
							 MaxHeight="600"
							 RowDetailsVisibilityMode="VisibleWhenSelected"
							 helpers:DataGridAutoSaveBehavior.IsEnabled="True"
							 Grid.Row="0">
					<ui:DataGrid.Columns>
						<DataGridTextColumn Header="Nomor Nota"
											Binding="{Binding NomorNota}"
											Width="*" />

						<DataGridTextColumn Header="Total Penjualan"
											Binding="{Binding TotalPenjualan}"
											Width="*" />

						<DataGridTextColumn Header="Total HPP"
											Binding="{Binding TotalHpp}"
											Width="*" />

						<DataGridTextColumn Header="Laba"
											Binding="{Binding Laba}"
											Width="*" />
					</ui:DataGrid.Columns>

					<ui:DataGrid.RowDetailsTemplate>
						<DataTemplate>
							<Border Padding="8"
									Margin="4"
									Background="#0F000000"
									CornerRadius="6">

								<StackPanel>

									<!-- DETAIL PENJUALAN -->
									<TextBlock Text="Detail Laba"
											   FontWeight="SemiBold"
											   Margin="0,0,0,6" />

									<ui:DataGrid ItemsSource="{Binding DetailLabas}"
												 AutoGenerateColumns="False"
												 CanUserAddRows="False"
												 HeadersVisibility="Column"
												 MaxHeight="250"
												 IsReadOnly="True"
												 helpers:DataGridAutoSaveBehavior.IsEnabled="True">

										<ui:DataGrid.Columns>

											<DataGridTextColumn Header="Produk"
																Binding="{Binding Produk}"
																IsReadOnly="True" />

											<DataGridTextColumn Header="Qty"
																Binding="{Binding Jumlah}" />

											<DataGridTextColumn Header="Harga Jual"
																Binding="{Binding HargaJual}" />

											<DataGridTextColumn Header="Subtotal"
																Binding="{Binding Subtotal}" />

											<DataGridTextColumn Header="HPP"
																Binding="{Binding Hpp}" />

											<DataGridTextColumn Header="Laba"
																Binding="{Binding Laba}" />

										</ui:DataGrid.Columns>
									</ui:DataGrid>
								</StackPanel>
							</Border>
						</DataTemplate>
					</ui:DataGrid.RowDetailsTemplate>
				</ui:DataGrid>
				<StackPanel Orientation="Horizontal"
							HorizontalAlignment="Center"
							Margin="0,8"
							Grid.Row="1">

					<Button Command="{Binding ViewModel.PrevPageCommand}"
							Content="◀"
							Margin="4" />

					<TextBlock Text="{Binding ViewModel.PageInfo}"
							   VerticalAlignment="Center"
							   Margin="8,0" />

					<Button Command="{Binding ViewModel.NextPageCommand}"
							Content="▶"
							Margin="4" />
				</StackPanel>
			</Grid>
		</Grid>
	</StackPanel>
</Page>
