<Window x:Class="MicroCashDevWPFUI.Views.Windows.LoginWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="clr-namespace:MicroCashDevWPFUI.Views.Windows"
		xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
		xmlns:helpers="clr-namespace:MicroCashDevWPFUI.Helpers"
		mc:Ignorable="d"
		Title="LoginWindow"
		Height="450"
		Width="800"
		WindowStartupLocation="CenterScreen"
		ResizeMode="NoResize"
		WindowStyle="None"
		Background="Transparent"
		AllowsTransparency="True"
		MouseDown="Window_MouseDown">

	<Grid>

		<Border CornerRadius="10"
				Padding="0">

			<Border CornerRadius="10"
					BorderThickness="1"
					BorderBrush="Red">

				<Border.Background>
					<LinearGradientBrush StartPoint="0,0.2"
										 EndPoint="1,0.8">
						<!-- Pink Area -->
						<GradientStop Color="Pink"
									  Offset="0" />
						<GradientStop Color="Pink"
									  Offset="0.5" />

						<!-- White Area -->
						<GradientStop Color="White"
									  Offset="0.5" />
						<GradientStop Color="White"
									  Offset="1" />
					</LinearGradientBrush>
				</Border.Background>

				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="30" />
						<RowDefinition />
					</Grid.RowDefinitions>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition />
							<ColumnDefinition Width="auto" />
							<ColumnDefinition Width="auto" />
						</Grid.ColumnDefinitions>

						<TextBlock Grid.Column="0"
								   Text="LOG IN"
								   Foreground="Black"
								   FontWeight="SemiBold"
								   VerticalAlignment="Center"
								   Margin="10,0,0,0" />

						<ui:Button x:Name="MinimizeButton"
								   Grid.Column="1"
								   Background="Transparent"
								   Foreground="DarkSlateGray"
								   ToolTip="Minimize"
								   VerticalAlignment="Center"
								   Margin="0,0,10,0"
								   Click="BtnMinimize_Click">
							<ui:SymbolIcon Symbol="ArrowMinimize24" />
						</ui:Button>

						<ui:Button x:Name="CloseButton"
								   Grid.Column="2"
								   Background="Transparent"
								   Foreground="DarkSlateGray"
								   ToolTip="Minimize"
								   VerticalAlignment="Center"
								   Margin="0,0,10,0"
								   Click="BtnClose_Click">
							<ui:SymbolIcon Symbol="Dismiss24" />
						</ui:Button>
					</Grid>

					<StackPanel Width="250"
								Grid.Row="1"
								Orientation="Vertical"
								Margin="0,35,0,0">

						<Border Padding="10">
							<Border.Effect>
								<DropShadowEffect Color="#40000000"
												  BlurRadius="25"
												  ShadowDepth="3" />
							</Border.Effect>

							<Image Source="/Assets/Logo.png"
								   Width="90"
								   Height="90" />
						</Border>

						<TextBlock Text="MICROCASH"
								   FontWeight="SemiBold"
								   FontSize="26"
								   HorizontalAlignment="Center"
								   TextOptions.TextFormattingMode="Ideal"
								   TextOptions.TextRenderingMode="ClearType" />

						<TextBlock Text="Efficient cashier apps enhance business transactions and inventory management."
								   FontSize="12"
								   TextAlignment="Center"
								   Margin="8,4,8,12"
								   Opacity="0.85"
								   TextWrapping="Wrap" />

						<StackPanel Orientation="Horizontal"
									HorizontalAlignment="Center">
							<ui:TextBox x:Name="NameTextBox"
										Margin="10"
										Width="200"
										PlaceholderText="Username"
										KeyDown="UsernameTextBox_KeyDown">
								<ui:TextBox.Text>
									<Binding Path="Username"
											 UpdateSourceTrigger="PropertyChanged">
									</Binding>
								</ui:TextBox.Text>
							</ui:TextBox>
						</StackPanel>

						<StackPanel Orientation="Horizontal"
									HorizontalAlignment="Center">
							<ui:PasswordBox x:Name="PasswordBox"
											Margin="10"
											Width="200"
											Icon="Password24"
											PlaceholderText="Password"
											helpers:PasswordBoxHelper.BindPassword="True"
											helpers:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay}">
								<ui:PasswordBox.InputBindings>
									<KeyBinding Key="Enter"
												Command="{Binding LoginCommand}" />
								</ui:PasswordBox.InputBindings>
							</ui:PasswordBox>
						</StackPanel>

						<ui:Button Appearance="Primary"
								   Height="40"
								   Width="200"
								   Command="{Binding LoginCommand}"
								   HorizontalAlignment="Center"
								   Content="Login" />

					</StackPanel>

				</Grid>
			</Border>
		</Border>
		<ContentPresenter x:Name="LoginDialogHost"
						  HorizontalAlignment="Stretch"
						  VerticalAlignment="Stretch"
						  Panel.ZIndex="999" />
	</Grid>
</Window>
