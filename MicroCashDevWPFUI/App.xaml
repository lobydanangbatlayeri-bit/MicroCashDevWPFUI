<Application x:Class="MicroCashDevWPFUI.App"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
			 DispatcherUnhandledException="OnDispatcherUnhandledException"
			 xmlns:conv="clr-namespace:MicroCashDevWPFUI.Converters"
			 xmlns:helpers="clr-namespace:MicroCashDevWPFUI.Helpers"
			 Exit="OnExit"
			 Startup="OnStartup">
	<Application.Resources>
		<ResourceDictionary>
			<conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
			<conv:InverseBoolConverter x:Key="InverseBoolConverter" />
			<conv:DecimalToFormattedStringConverter x:Key="DecimalFormat" />
			<ResourceDictionary.MergedDictionaries>
				<ui:ThemesDictionary Theme="Light" />
				<ui:ControlsDictionary />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Application.Resources>
</Application>
